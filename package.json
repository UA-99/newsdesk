{
  "name": "newsdesk",
  "version": "0.1.0",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "package": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.13.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.5.0",
    "cross-fetch": "^4.1.0",
    "jsdom": "^27.3.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.newsdesk.app",
    "productName": "Newsdesk",
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "!node_modules/.cache/**"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;News"
    },
    "mac": {
      "category": "public.app-category.news",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
